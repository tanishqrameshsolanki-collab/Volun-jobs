{
  "name": "volun-jobs",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --filter @tanishq/web dev",
    "build": "pnpm --filter @tanishq/web build",
    "lint": "pnpm --filter @tanishq/web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "apply:live": "node scripts/apply-approved.mjs",
    "apply:live:headed": "node scripts/apply-approved.mjs --headed",
    "apply:submit": "node scripts/apply-approved.mjs --submit"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "supabase": "^2.116.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4"
  }
}
